{
  "name": "orphan-files",
  "version": "1.0.1",
  "description": "🔨 Find unused files in your JavaScript/TypeScript project by analysing the import graph",
  "main": "index.js",
  "types": "types/index.d.ts",
  "bin": {
    "orphan-files": "bin/orphan-files.js"
  },
  "files": [
    "bin/",
    "lib/",
    "types/",
    "index.js",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "!**/*.spec.*",
    "!**/*.test.*",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postversion": "auto-changelog && git add CHANGELOG.md && git commit --amend --no-edit --no-verify && git tag -f v$npm_package_version"
  },
  "keywords": [
    "cli",
    "unused",
    "unused-files",
    "unused-code",
    "dead-code",
    "dead-files",
    "orphan-files",
    "orphaned-files",
    "files",
    "imports",
    "import-graph",
    "dependency-graph",
    "javascript",
    "typescript",
    "static-analysis",
    "code-quality",
    "cleanup",
    "refactoring",
    "monorepo",
    "ast",
    "babel",
    "sarif",
    "knip-alternative",
    "tree-shaking",
    "developer-tools"
  ],
  "author": {
    "name": "Piotr Kowalski",
    "email": "piecioshka@gmail.com",
    "url": "https://piecioshka.pl"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/piecioshka/orphan-files.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.12.0"
  },
  "type": "module",
  "dependencies": {
    "@babel/parser": "^7.28.5",
    "@babel/traverse": "^7.28.5",
    "@babel/types": "^7.28.5",
    "glob": "^13.0.0",
    "minimatch": "^10.1.1",
    "minimist": "^1.2.8"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.8",
    "auto-changelog": "^2.6.0",
    "prettier": "^3.9.6",
    "vitest": "^4.1.8"
  },
  "auto-changelog": {
    "commitLimit": false,
    "backfillLimit": false,
    "hideCredit": true
  },
  "homepage": "https://github.com/piecioshka/orphan-files#readme",
  "bugs": {
    "url": "https://github.com/piecioshka/orphan-files/issues"
  }
}
